<?xml version="1.0" encoding="utf-8"?>
<!-- KLayout layer properties for GDS exported by Quantum Metal (QGDSRenderer).
     layer = the design layer; datatype 10 = polygons, 11 = paths, 0 = ground plane,
     100 = cheese holes, 99 = no-cheese keep-out (options.cheese.datatype and
     options.no_cheese.datatype). Edit the layer list for designs with more layers. -->
<layer-properties>
 <properties>
  <frame-color>#b04a3c</frame-color>
  <fill-color>#b04a3c</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>I9</dither-pattern>
  <line-style/>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width/>
  <marked>false</marked>
  <xfill>false</xfill>
  <animation>0</animation>
  <name>1/10 polygons: metal and the ground-plane outline</name>
  <source>1/10@*</source>
 </properties>
 <properties>
  <frame-color>#b04a3c</frame-color>
